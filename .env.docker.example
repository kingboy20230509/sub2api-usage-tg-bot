# Non-secret Docker runtime settings. Secrets are mounted from ./secrets by compose.example.yaml.

# This must exactly match the PostgreSQL service name in your Compose file.
SUB2API_TG_BOT_PGHOST=sub2api-postgres
SUB2API_TG_BOT_PGPORT=5432
SUB2API_TG_BOT_PGDATABASE=sub2api
SUB2API_TG_BOT_PGUSER=sub2api_tg_bot

SUB2API_TG_BOT_ALERT_CHECK_INTERVAL=600
SUB2API_TG_BOT_POLL_TIMEOUT=10
SUB2API_TG_BOT_UPDATE_WORKERS=4
SUB2API_TG_BOT_UPDATE_MAX_PENDING=16
SUB2API_TG_BOT_CHECK_COOLDOWN=10
