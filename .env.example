# Telegram Bot API token from @BotFather
TELEGRAM_BOT_TOKEN=123456789:replace_me
# Docker secret alternative: TELEGRAM_BOT_TOKEN_FILE=/run/secrets/telegram_bot_token

# Optional admin-only rate-limit reset through the Sub2API admin API.
# Plain HTTP is accepted only for localhost or a single-label Compose service.
SUB2API_BASE_URL=http://127.0.0.1:8080
SUB2API_ADMIN_API_KEY=replace_me_with_the_sub2api_admin_api_key
# Docker secret alternative: SUB2API_ADMIN_API_KEY_FILE=/run/secrets/sub2api_admin_api_key
SUB2API_ADMIN_TIMEOUT=10

# Internal health listener; do not publish this port.
LISTEN_HOST=127.0.0.1
LISTEN_PORT=8099

# Runtime config file path
SUB2API_TG_BOT_CONFIG=/opt/sub2api-tg-bot/config.json

# Restricted PostgreSQL role created by deploy/create_readonly_role.sql
PSQL_BIN=/usr/bin/psql
PGHOST=127.0.0.1
PGPORT=5432
PGDATABASE=sub2api
PGUSER=sub2api_tg_bot
PGPASSWORD=replace_me_with_the_restricted_role_password
# Docker secret alternative: PGPASSWORD_FILE=/run/secrets/postgres_password
PGSSLMODE=prefer

# Set to 1 only when PGHOST is a single-label service name on an isolated
# Compose network and PGSSLMODE=disable. Keep 0 for all other deployments.
PG_ALLOW_INSECURE_PRIVATE_NETWORK=0

# Telegram long polling and update safety limits
POLL_TIMEOUT=10
UPDATE_WORKERS=4
UPDATE_MAX_PENDING=16
CHECK_COOLDOWN=10

# Weekly alert loop
ALERT_CHECK_INTERVAL=600
ALERT_STATE_PATH=/var/lib/sub2api-tg-bot/alert_state.json
